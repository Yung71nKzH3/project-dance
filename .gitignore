# Node dependencies
node_modules/

# Production build output
dist/

# Local environment & secret files
.env
.env.*
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS metadata
.DS_Store
Thumbs.db

# Large Cloudflare binary (auto-downloaded by scripts/remote.js on first run)
scripts/cloudflared.exe

# User video files (kept on local PC, not committed to git repository)
videos/*.mp4
videos/*.webm
videos/*.mov
videos/*.mkv
videos/*.avi
!videos/.gitkeep
!videos/README.md

# IDE & Editor caches
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
